#!/usr/bin/env php
<?php

if (PHP_SAPI !== 'cli')
    die('this script must be run from CLI'.PHP_EOL);
if (PHP_SAPI === 'cli' && getcwd().DIRECTORY_SEPARATOR.'aowow' != __FILE__)
{
    fwrite(STDERR, 'this script must be run from the aowow root directory'.PHP_EOL);
    exit(1);
}

require_once 'includes/kernel.php';

require_once 'setup/setup.php';

?>
